# Ring topology
# Presence-only ring-system predicate; count is 0 or 1. Highlighted atom belongs to the matching system.
name: "fused_aromatic_aliphatic_2"
query {
  ring_system_specifier {
    base { set_global_id: 1 }

    rings_in_system: 2
    aromatic_ring_count: 1
    non_aromatic_ring_count: 1
  }
  smarts: "[/IWgid1]"
  max_matches_to_find: 1
}
