query {
  # Direct halogens are separate from the methoxy query.
  # A length-two group merely containing F could otherwise admit fluoromethyl/CF3.
  comment: "activated_sulfonamide_halogen"
  ring_specifier {
    base {
      set_global_id: 1
      environment: "a-[F,Cl,Br,I]"
    }
    aromatic: 1
  }
  smarts: "[/IWgid1a]-[/IWNv{-1}ND2H1]-S(=O)(=O)"
}
