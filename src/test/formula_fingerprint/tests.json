{
  "executable": "formula_fingerprint",
  "difftool": "diff",
  "test": [
    {
      "name": "sparse_default",
      "args": [
        "-J NCFML #{indir}/in.smi"
      ]
    },
    {
      "name": "sparse_unscaled",
      "args": [
        "-J NCFML -L none #{indir}/in.smi"
      ]
    },
    {
      "name": "fixed_counted",
      "args": [
        "#{indir}/in.smi"
      ]
    },
    {
      "name": "fixed_counted_tag",
      "args": [
        "-J FCTEST #{indir}/in.smi"
      ]
    },
    {
      "name": "invalid_tag",
      "args": [
        "-J XXFML #{indir}/in.smi"
      ],
      "ignore_file": [
        "stderr"
      ],
      "non_zero_rc_expected": true
    },
    {
      "name": "no_hydrogens",
      "args": [
        "-H #{indir}/in.smi"
      ]
    },
    {
      "name": "no_hydrogens_sparse",
      "args": [
        "-H -J NCFMLNH #{indir}/in.smi"
      ]
    },
    {
      "name": "hydrogen_tag_without_option",
      "args": [
        "-J FCFMLNH #{indir}/in.smi"
      ],
      "ignore_file": [
        "stderr"
      ],
      "non_zero_rc_expected": true
    },
    {
      "name": "no_hydrogens_with_hydrogen_tag",
      "args": [
        "-H -J FCFML #{indir}/in.smi"
      ],
      "ignore_file": [
        "stderr"
      ],
      "non_zero_rc_expected": true
    }
  ]
}
