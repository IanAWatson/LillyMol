{
  "executable": "chemotypes",
  "test": [
    {
      "name": "seed_ring_only",
      "args": [
        "-s '[N]' -z i -i smi #{indir}/input.smi"
      ]
    },
    {
      "name": "adjacent_ring",
      "args": [
        "-s '[c]' -n 1 -i smi #{indir}/input.smi"
      ]
    },
    {
      "name": "ties_at_cutoff",
      "args": [
        "-s '[c]' -n 1 -t -i smi #{indir}/input.smi"
      ]
    },
    {
      "name": "write_parent",
      "args": [
        "-s '[N]' -p -z i -i smi #{indir}/input.smi"
      ]
    },
    {
      "name": "summary_textproto",
      "args": [
        "-s '[N]' -z i -i smi -F summary.textproto #{indir}/input.smi"
      ]
    }
  ]
}
